{
  "uid": "kisansense-main",
  "title": "KisanSense serving and drift",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "10s",
  "time": { "from": "now-30m", "to": "now" },
  "panels": [
    {
      "id": 1, "type": "timeseries", "title": "Request rate (per second)",
      "gridPos": { "h": 8, "w": 8, "x": 0, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(http_requests_total{endpoint=\"predict\"}[1m])) by (status)", "legendFormat": "status {{status}}" }
      ]
    },
    {
      "id": 2, "type": "timeseries", "title": "Prediction latency p50 and p95 (seconds)",
      "gridPos": { "h": 8, "w": 8, "x": 8, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "histogram_quantile(0.50, sum(rate(predict_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p50" },
        { "expr": "histogram_quantile(0.95, sum(rate(predict_latency_seconds_bucket[5m])) by (le))", "legendFormat": "p95" }
      ]
    },
    {
      "id": 3, "type": "stat", "title": "Drift detected (1 = yes)",
      "gridPos": { "h": 8, "w": 8, "x": 16, "y": 0 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "max(drift_detected)" } ],
      "fieldConfig": {
        "defaults": {
          "mappings": [ { "type": "value", "options": { "0": { "text": "OK" }, "1": { "text": "DRIFT" } } } ],
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] },
          "color": { "mode": "thresholds" }
        }
      }
    },
    {
      "id": 4, "type": "bargauge", "title": "KS statistic per feature (0.15 = drift threshold)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "max(feature_drift_ks) by (feature)", "legendFormat": "{{feature}}" } ],
      "fieldConfig": {
        "defaults": {
          "min": 0, "max": 0.6,
          "thresholds": { "mode": "absolute", "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 0.15 } ] }
        }
      }
    },
    {
      "id": 5, "type": "timeseries", "title": "Top recommended crop (predictions per minute)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "topk(6, sum(rate(predictions_total[5m])) by (crop) * 60)", "legendFormat": "{{crop}}" } ]
    },
    {
      "id": 6, "type": "stat", "title": "Low-confidence share (last 15m)",
      "gridPos": { "h": 6, "w": 8, "x": 0, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "sum(rate(low_confidence_predictions_total[15m])) / sum(rate(predictions_total[15m]))" } ],
      "fieldConfig": { "defaults": { "unit": "percentunit" } }
    },
    {
      "id": 7, "type": "table", "title": "Model version in use",
      "gridPos": { "h": 6, "w": 8, "x": 8, "y": 16 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [ { "expr": "model_info == 1", "format": "table", "instant": true } ]
    }
  ]
}
